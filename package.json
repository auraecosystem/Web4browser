{
  "name": "web4browser",
  "version": "1.1.0",
  "private": true,
  "description": "Web4browser hybrid desktop browser and Web4 research workspace",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "desktop": "electron .",
    "dist:desktop": "electron-builder"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.20.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.0",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "org.qubuhub.web4browser",
    "productName": "Web4browser",
    "files": ["desktop/**/*", "package.json"],
    "directories": { "output": "release" },
    "linux": { "target": ["AppImage"] },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] }
  }
}
